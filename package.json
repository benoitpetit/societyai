{
  "name": "societyai",
  "version": "0.1.6",
  "description": "A powerful TypeScript library for creating collaborative multi-agent AI systems with DAG-based orchestration. Build sophisticated workflows where AI agents work together through dependency graphs, conditional routing, and pluggable execution strategies. Features thread-safe parallel execution, memory management, and circuit breaker patterns for production-grade reliability.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js",
      "require": "./dist/advanced.js",
      "default": "./dist/advanced.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js",
      "require": "./dist/memory.js",
      "default": "./dist/memory.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "require": "./dist/events.js",
      "default": "./dist/events.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.js",
      "default": "./dist/context.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "societyai": "bin/societyai.js",
    "society-inspect": "bin/inspect.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=7.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test",
    "prepare": "husky",
    "prepublishOnly": "npm run validate && npm run build",
    "prepack": "npm run build",
    "check": "node scripts/check-package.js",
    "clean": "rm -rf dist",
    "clean:all": "rm -rf dist node_modules package-lock.json",
    "inspect": "ts-node src/bin/inspect.ts"
  },
  "keywords": [
    "ai",
    "artificial-intelligence",
    "agents",
    "multi-agent",
    "multi-agent-systems",
    "collaboration",
    "llm",
    "large-language-models",
    "prompt",
    "prompt-engineering",
    "society",
    "workflow",
    "orchestration",
    "typescript",
    "openai",
    "anthropic",
    "claude",
    "gpt",
    "chatgpt",
    "model-agnostic",
    "rag",
    "memory",
    "tools",
    "function-calling"
  ],
  "author": "Benoit Petit <contact@societyai.vercel.app> (https://github.com/benoitpetit)",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.19.33",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.56.0",
    "fast-check": "^3.15.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@opentelemetry/api": "^1.9.0",
    "ioredis": "^5.0.0",
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/benoitpetit/societyai"
  },
  "bugs": {
    "url": "https://github.com/benoitpetit/societyai/issues"
  },
  "homepage": "https://github.com/benoitpetit/societyai#readme",
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
