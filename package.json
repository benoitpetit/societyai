{
    "name": "@societyai/core",
    "version": "1.0.0",
    "description": "Bibliothèque pour créer une société d'agents d'intelligence artificielle collaborant ensemble pour analyser des prompts complexes et générer des réponses approfondies et cohérentes",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc",
        "watch": "tsc --watch",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "prepublishOnly": "npm run build",
        "clean": "rm -rf dist"
    },
    "keywords": [
        "ai",
        "artificial-intelligence",
        "agents",
        "multi-agent",
        "collaboration",
        "llm",
        "prompt",
        "society",
        "typescript"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.5.11",
        "@types/node": "^20.10.6",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "prettier": "^3.1.1",
        "ts-jest": "^29.1.1",
        "typescript": "^5.3.3"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/benoitpetit/societyai"
    },
    "bugs": {
        "url": "https://github.com/benoitpetit/societyai/issues"
    },
    "homepage": "https://github.com/benoitpetit/societyai#readme"
}